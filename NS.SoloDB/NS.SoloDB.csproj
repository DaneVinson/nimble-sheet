<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NSSoloDB</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      CVE-2025-6965 (GHSA-2m69-gcr7-jv3q): SoloDB 1.2.x transitively pins the SQLitePCLRaw 2.1.11
      family, whose native SQLite (< 3.50.2) carries this high-severity flaw. There is no fix we can
      apply today: the only patched engine ships in the SQLitePCLRaw 3.x family, and forcing it breaks
      SoloDB's connection-pool transaction logic at runtime ("cannot start a transaction within a
      transaction"). Upstream is stuck too - SoloDB 1.2.3 and Microsoft.Data.Sqlite 10.0.9 both still
      pin 2.1.11. The flaw requires executing crafted SQL, which this app never does (SoloDB owns all
      SQL over a fixed schema; the API surface is JSON only), so it is unreachable here. Suppress the
      warning and revert this once SoloDB ships a patched (SQLitePCLRaw 3.x / SQLite >= 3.50.2) graph.
    -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="SoloDB" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NS.Domain\NS.Domain.csproj" />
  </ItemGroup>

</Project>
